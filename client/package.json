    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.63.0",
    "prettier": "^3.4.0",
    "rimraf": "^6.0.0",
    "typescript": "^6.0.3",
    "vite": "^6.0.0",
    "vitest": "^3.1.0"
